# ─── NEAR Network ───────────────────────────────────────────────────────────
NEAR_NETWORK=testnet

# Agent NEAR account (Funded account with bond, or function-call key if 0-bond policy)
NEAR_ACCOUNT_ID=zinipay-agent.testnet
NEAR_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE

# ─── Sputnik DAO / Trezu ─────────────────────────────────────────────────────
# The Sputnik DAO contract the agent will propose into
DAO_CONTRACT_ID=your-dao.sputnik-dao.testnet

# On-chain Policy Helper contract (optional, for atomic release rules)
POLICY_CONTRACT_ID=policy.zinipay.testnet

# Proposal bond (configured in DAO policy, e.g. 1 NEAR or 0)
PROPOSAL_BOND=1000000000000000000000000

# ─── Policy Defaults ─────────────────────────────────────────────────────────
# Maximum single payout the agent may propose (in yoctoNEAR)
MAX_SPEND_PER_PROPOSAL=10000000000000000000000000
# Max spend per calendar day (in yoctoNEAR)
MAX_SPEND_PER_DAY=50000000000000000000000000
# Minimum hours between proposals to the same recipient
COOLDOWN_HOURS=24
# Minimum reputation score a recipient must have (0 = disabled)
MIN_REPUTATION_SCORE=0

# ─── LLM Deliberation (NEAR AI Cloud) ────────────────────────────────────────
# Official NEAR AI Cloud endpoint: https://cloud-api.near.ai/v1
# Or any OpenAI-compatible endpoint. Requires --dry-run if omitted.
OPENAI_BASE_URL=https://cloud-api.near.ai/v1
OPENAI_API_KEY=YOUR_NEAR_AI_OR_OPENAI_KEY
OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ─── NEAR Intents (1Click cross-chain settlement) ─────────────────────────────
INTENTS_API_URL=https://1click.chaindefuser.com

# ─── Local State ─────────────────────────────────────────────────────────────
# lowdb JSON file for cooldown, proposals, and anti-replay deliverable tracking
DB_PATH=./zinipay.json
