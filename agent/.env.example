# ─── NEAR Network ───────────────────────────────────────────────────────────
NEAR_NETWORK=testnet

# Agent NEAR account (use a function-call key, not a full-access key)
NEAR_ACCOUNT_ID=syncommons-agent.testnet
NEAR_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE

# ─── Sputnik DAO / Trezu ─────────────────────────────────────────────────────
# The Sputnik DAO contract the agent will propose into
# On testnet: create one at https://testnet.sputnik.fund or via near CLI
DAO_CONTRACT_ID=your-dao.sputnik-dao.testnet

# Proposal bond (1 NEAR minimum for most DAOs)
PROPOSAL_BOND=1000000000000000000000000

# ─── Policy Defaults (overridden by on-chain policy if available) ─────────────
# Maximum single payout the agent may propose (in yoctoNEAR)
MAX_SPEND_PER_PROPOSAL=10000000000000000000000000
# Max spend per calendar day (in yoctoNEAR)
MAX_SPEND_PER_DAY=50000000000000000000000000
# Minimum hours between proposals to the same recipient
COOLDOWN_HOURS=24
# Minimum reputation score a recipient must have (0 = disabled)
MIN_REPUTATION_SCORE=0

# ─── LLM Validator ───────────────────────────────────────────────────────────
# Use NEAR AI Cloud (TEE-backed): https://api.near.ai/v1
# Or any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.near.ai/v1
OPENAI_API_KEY=YOUR_NEAR_AI_OR_OPENAI_KEY
OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ─── NEAR Intents (cross-chain settlement) ───────────────────────────────────
INTENTS_API_URL=https://1click.chaindefuser.com

# ─── Local State ─────────────────────────────────────────────────────────────
# SQLite file for cooldown + reputation tracking
DB_PATH=./syncommons.db
