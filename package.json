{
  "name": "zinipay",
  "version": "1.0.0",
  "description": "ZiniPay: Constrained Agent Layer for Community Treasuries (Sputnik DAO & Trezu)",
  "private": true,
  "workspaces": [
    "agent",
    "frontend"
  ],
  "scripts": {
    "start": "node server.mjs",
    "build": "cd frontend && npm run build",
    "frontend:build": "cd frontend && npm run build",
    "agent:build": "cd agent && npm run build",
    "agent:dev": "npm --workspace=@zinipay/agent run dev",
    "agent:propose": "node node_modules/tsx/dist/cli.mjs agent/src/index.ts propose",
    "agent:inspect": "node node_modules/tsx/dist/cli.mjs agent/src/index.ts --inspect",
    "agent:demo": "node node_modules/tsx/dist/cli.mjs agent/src/index.ts --demo",
    "frontend:dev": "npm --workspace=@zinipay/frontend run dev",
    "setup:testnet": "node scripts/setup-testnet.mjs",
    "test": "npm --workspace=@zinipay/agent test",
    "test:e2e": "node scripts/e2e-testnet.mjs",
    "verify:proposal": "node scripts/verify-proposal.mjs",
    "verify:reputation": "node scripts/verify-reputation.mjs",
    "verify:testnet": "node scripts/verify-testnet.mjs",
    "demo:social-money": "npm run agent:build && node scripts/demo-social-money.mjs",
    "demo": "node node_modules/tsx/dist/cli.mjs agent/src/index.ts --demo",
    "inspect": "node node_modules/tsx/dist/cli.mjs agent/src/index.ts --inspect"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "tsx": "^4.19.2"
  },
  "overrides": {
    "@freedomofpress/crypto-browser": {
      "@noble/curves": "2.4.0"
    }
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001820",
    "clsx": "^2.1.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
