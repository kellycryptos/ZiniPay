{
  "name": "zinipay",
  "version": "1.0.0",
  "description": "ZiniPay: 100% NEAR-Aligned Constrained Agent Layer for Community Treasuries (Sputnik DAO & Trezu)",
  "private": true,
  "workspaces": [
    "agent",
    "frontend"
  ],
  "scripts": {
    "build": "cd frontend && npm run build",
    "frontend:build": "cd frontend && npm run build",
    "agent:build": "cd agent && npm run build",
    "agent:dev": "npm --workspace=@zinipay/agent run dev",
    "agent:propose": "npm --workspace=@zinipay/agent run propose",
    "frontend:dev": "npm --workspace=@zinipay/frontend run dev",
    "setup:testnet": "node scripts/setup-testnet.mjs",
    "test:e2e": "node scripts/e2e-testnet.mjs"
  }
}
